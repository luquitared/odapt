# Your own control plane: bun run control (or control/Dockerfile with --env-file control.env)
CONTROL_DATABASE_URL=postgres://user:pass@host/odapt?sslmode=require
CONTROL_PUBLIC_URL=http://127.0.0.1:7790
BETTER_AUTH_SECRET=                # openssl rand -base64 32
STRIPE_SECRET_KEY=                 # restricted: write Checkout Sessions, Refunds, Customers; read PaymentIntents, Charges, Balance transactions
STRIPE_WEBHOOK_SECRET=             # endpoint <CONTROL_PUBLIC_URL>/stripe/webhook
STRIPE_PUBLISHABLE_KEY=            # same account and mode as the secret key; unset → no in-page checkout
OPENROUTER_API_KEY=
REPLICATE_API_TOKEN=
MUAPI_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=                  # unset → email links only
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=                    # unset → sign-in links are printed to the log
# CONTROL_MAIL_FROM="Odapt <login@odapt.ai>"
# CONTROL_DAILY_CAP_USD=20
