# Copy to .env (Bun loads it). Everything is optional: mock mode (the default) needs no keys.

# The engine (bun start → http://127.0.0.1:7788)
# SNAP_PORT=7788
# SNAP_HARNESS=claude              # claude | codex | deepseek-flash (harnesses.json)
ANTHROPIC_API_KEY=                 # or be logged in to `claude`
OPENROUTER_API_KEY=                # harnesses with "provider": "openrouter"
REPLICATE_API_TOKEN=               # real generation through `rep`
GEMINI_API_KEY=                    # `vidwatch`
OPENAI_API_KEY=                    # voice calls without a control plane

# Run sessions on a control plane's accounts and credit instead of your own keys
# SNAP_CONTROL_URL=https://api.odapt.ai

# Standalone apps
# ODAPT_URL=https://api.odapt.ai
# ODAPT_APP_KEY=
